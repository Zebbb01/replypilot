# Copy to .env.local for `npm run dev`. With `npm run services` running, these point at
# the local stand-ins (embedded PostgreSQL and a rule-based mock model); in Azure,
# Terraform sets the real ones.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/postgres
LLM_ENDPOINT=http://127.0.0.1:4021
LLM_API_KEY=local
LLM_MODEL=mock
OPERATOR_KEY=local-operator-key

# Real model: GitHub Models' free tier (a token with models:read), or any
# OpenAI-compatible endpoint with tool calling.
# LLM_ENDPOINT=https://models.github.ai/inference
# LLM_API_KEY=github_pat_...
# LLM_MODEL=openai/gpt-4.1-mini

# Live inbox (optional). Without SHOPIFY_SHOP, live tickets look orders up in samples/orders.json.
# INBOUND_EMAIL_SECRET=      # password for the inbound email webhook (HTTP basic auth)
# SHOPIFY_SHOP=your-dev-store   # the part before .myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=     # also verifies webhook signatures
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_FROM="Kettle & Pine Support <you@gmail.com>"
